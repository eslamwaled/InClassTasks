{
	"info": {
		"_postman_id": "3f8a2c1e-9b4d-4e6a-8c7f-2b5d9e1f4a6c",
		"name": "Session28Api",
		"description": "JWT authentication flow for Session28Api. Run Register once, then Login — its test script stores the returned JWT in the accessToken environment variable, which the Create Product and Delete Product requests use automatically. Select the Session28Api environment before running.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Register",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"student@session28.com\",\n  \"userName\": \"student\",\n  \"password\": \"P@ssw0rd!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/register",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"register"
					]
				},
				"description": "Creates a new user account. Returns 409 if the email is already registered."
			},
			"response": []
		},
		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"const json = pm.response.json();",
							"pm.environment.set(\"accessToken\", json.token);",
							"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"student@session28.com\",\n  \"password\": \"P@ssw0rd!\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/auth/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				},
				"description": "Authenticates the user and stores the returned JWT in the accessToken environment variable."
			},
			"response": []
		},
		{
			"name": "Get All Products",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products"
					]
				},
				"description": "Public endpoint. Returns every product."
			},
			"response": []
		},
		{
			"name": "Get Product By Id",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products",
						"1"
					]
				},
				"description": "Public endpoint. Returns 404 when the product does not exist."
			},
			"response": []
		},
		{
			"name": "Create Product",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"price\": 149.99\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products"
					]
				},
				"description": "Secured endpoint. Uses the accessToken captured by the Login request."
			},
			"response": []
		},
		{
			"name": "Delete Product",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{accessToken}}",
							"type": "string"
						}
					]
				},
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"products",
						"1"
					]
				},
				"description": "Secured endpoint. Uses the accessToken captured by the Login request. Returns 404 when the product does not exist."
			},
			"response": []
		}
	]
}
